title: The "Lautenbach" Plan
subtitle: A light at the end of the tunnel?
view-if: (black_thursday_seen and lautenbach_support > 3) or year = 1931 and month = 9
max-visits: 1
tags: event
new-page: true
on-arrival: crisis_urgency += 1; wtb_support += 1
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/greatdepression.jpg";  

